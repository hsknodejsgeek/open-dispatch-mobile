# Base URL for the Fastify backend (../server). Optional — if unset, the
# app defaults to http://localhost:3001 (iOS simulator) or
# http://10.0.2.2:3001 (Android emulator). Set this to your machine's LAN IP
# (e.g. http://192.168.1.20:3001) to test on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3001
